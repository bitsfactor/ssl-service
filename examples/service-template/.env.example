# Reference only — the platform writes the real .env at deploy time
# from .deploy.yaml `defaults` + per-deploy overrides + system_config
# secrets. Never commit a real .env with credentials to git.

PORT=8080
LOG_LEVEL=info
TZ=Asia/Shanghai

# These are required (.deploy.yaml -> required_env). The platform will
# refuse to deploy if you don't provide values for them.
DATABASE_URL=
JWT_SECRET=
